[0.051, "o", "\u001b[1m\u001b[7m%\u001b[27m\u001b[1m\u001b[0m                                                                                                                        \r \r"]
[0.000, "o", "\r\u001b[0m\u001b[27m\u001b[24m\u001b[Jdubovaya_roshcha@MacBook-Pro-Vadim project2_dubinin_m26-555 % \u001b[K\u001b[?2004h"]
[6.834, "o", "\u001b[7muv run database\u001b[27m"]
[1.119, "o", "\u001b[15D\u001b[27mu\u001b[27mv\u001b[27m \u001b[27mr\u001b[27mu\u001b[27mn\u001b[27m \u001b[27md\u001b[27ma\u001b[27mt\u001b[27ma\u001b[27mb\u001b[27ma\u001b[27ms\u001b[27me\u001b[?2004l\r\r\n"]
[0.151, "o", "\r\n***Процесс работы с таблицей***\r\nФункции:\r\n<command> create_table <имя_таблицы> <столбец1:тип> ... - создать таблицу\r\n<command> list_tables - показать список всех таблиц\r\n<command> drop_table <имя_таблицы> - удалить таблицу\r\n\r\n***Операции с данными***\r\n<command> insert into <имя_таблицы> values (<значение1>, ...) - создать запись\r\n<command> select from <имя_таблицы> where <столбец> = <значение> - найти записи\r\n<command> select from <имя_таблицы> - показать все записи\r\n"]
[0.000, "o", "<command> update <имя_таблицы> set <столбец> = <значение> where <столбец> = <значение> - обновить запись\r\n<command> delete from <имя_таблицы> where <столбец> = <значение> - удалить запись\r\n<command> info <имя_таблицы> - информация о таблице\r\n\r\nОбщие команды:\r\n<command> exit - выход из программы\r\n<command> help - справочная информация\r\n\r\n"]
[0.000, "o", "Введите команду: "]
[9.569, "o", "create_table books title:str year:int available:bo"]
[0.008, "o", "ol"]
[0.917, "o", "\r\n"]
[0.002, "o", "Таблица \"books\" успешно создана со столбцами: ID:int, title:str, year:int, available:bool\r\n"]
[0.001, "o", "Введите команду: "]
[9.241, "o", "insert into books values (\"Dune\", 1965, true)"]
[0.767, "o", "\r\n"]
[0.001, "o", "Запись с ID=1 успешно добавлена в таблицу \"books\".\r\n"]
[0.001, "o", "Функция insert выполнилась за 0.000 секунд\r\n"]
[0.001, "o", "Введите команду: "]
[8.076, "o", "insert into books values (\"1984\", 1949, false)"]
[1.108, "o", "\r\n"]
[0.001, "o", "Запись с ID=2 успешно добавлена в таблицу \"books\".\r\n"]
[0.000, "o", "Функция insert выполнилась за 0.001 секунд\r\n"]
[0.000, "o", "Введите команду: "]
[7.241, "o", "select from books"]
[0.800, "o", "\r\n"]
[0.002, "o", "Функция select выполнилась за 0.000 секунд\r\n"]
[0.040, "o", "+----+-------+------+-----------+\r\n| ID | title | year | available |\r\n+----+-------+------+-----------+\r\n| 1  |  Dune | 1965 |    True   |\r\n| 2  |  1984 | 1949 |   False   |\r\n+----+-------+------+-----------+\r\n"]
[0.001, "o", "Введите команду: "]
[12.648, "o", "select from books where year = 1965"]
[1.076, "o", "\r\n"]
[0.001, "o", "Функция select выполнилась за 0.000 секунд\r\n"]
[0.000, "o", "+----+-------+------+-----------+\r\n| ID | title | year | available |\r\n+----+-------+------+-----------+\r\n| 1  |  Dune | 1965 |    True   |\r\n+----+-------+------+-----------+\r\n"]
[0.001, "o", "Введите команду: "]
[6.428, "o", "update books set year = 1966 where title = \"Dune\""]
[1.092, "o", "\r\n"]
[0.001, "o", "Запись с ID=1 в таблице \"books\" успешно обновлена.\r\n"]
[0.001, "o", "Введите команду: "]
[7.750, "o", "select from books"]
[0.849, "o", "\r\n"]
[0.001, "o", "Функция select выполнилась за 0.000 секунд\r\n"]
[0.000, "o", "+----+-------+------+-----------+\r\n| ID | title | year | available |\r\n+----+-------+------+-----------+\r\n| 1  |  Dune | 1966 |    True   |\r\n| 2  |  1984 | 1949 |   False   |\r\n+----+-------+------+-----------+\r\n"]
[0.001, "o", "Введите команду: "]
[5.923, "o", "info books"]
[0.754, "o", "\r\n"]
[0.002, "o", "Таблица: books\r\n"]
[0.000, "o", "Столбцы: ID:int, title:str, year:int, available:bool\r\n"]
[0.000, "o", "Количество записей: 2\r\n"]
[0.001, "o", "Введите команду: "]
[6.484, "o", "delete from books where title = \"1984\""]
[1.207, "o", "\r\n"]
[0.001, "o", "Вы уверены, что хотите выполнить \"удаление записей\"? [y/n]: "]
[6.781, "o", "y"]
[0.832, "o", "\r\n"]
[0.002, "o", "Запись с ID=2 успешно удалена из таблицы \"books\".\r\n"]
[0.002, "o", "Введите команду: "]
[9.099, "o", "select from books"]
[0.986, "o", "\r\n"]
[0.004, "o", "Функция select выполнилась за 0.000 секунд\r\n"]
[0.001, "o", "+----+-------+------+-----------+\r\n| ID | title | year | available |\r\n+----+-------+------+-----------+\r\n| 1  |  Dune | 1966 |    True   |\r\n+----+-------+------+-----------+\r\n"]
[0.001, "o", "Введите команду: "]
[6.418, "o", "drop_table books"]
[1.652, "o", "\r\n"]
[0.000, "o", "Вы уверены, что хотите выполнить \"удаление таблицы\"? [y/n]: "]
[5.217, "o", "y"]
[0.741, "o", "\r\n"]
[0.001, "o", "Таблица \"books\" успешно удалена.\r\n"]
